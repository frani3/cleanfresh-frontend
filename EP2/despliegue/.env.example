# Copiar a .env y completar. No subir .env a git.
ORDERS_DB_URL=jdbc:postgresql://<endpoint-rds>:5432/orders_db
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=
CATALOG_DB_URL=jdbc:postgresql://<endpoint-rds>:5432/catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=
NOTIFICACIONES_DB_URL=jdbc:postgresql://<endpoint-rds>:5432/notificaciones_db
NOTIFICACIONES_DB_USER=notificaciones_user
NOTIFICACIONES_DB_PASSWORD=

# RabbitMQ (Spec 033). El clúster corre en la EC2 cleanfresh-mq (EP2/despliegue/mq/):
# usar su IP PRIVADA. Apagado por defecto (RABBIT_ENABLED=false): sin broker los servicios arrancan igual.
RABBIT_ENABLED=true
RABBITMQ_ADDRESSES=<ip-privada-ec2-mq>:5672,<ip-privada-ec2-mq>:5673
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# API de administración de cada nodo (la usa ms-cleanfresh-mq-admin y los scripts de verificación)
RABBITMQ_MGMT_URLS=http://<ip-privada-ec2-mq>:15672/api,http://<ip-privada-ec2-mq>:15673/api

# EP5 (Spec 044): bases propias de reportes y auditoria (se crean con EP5/despliegue/rds-crear-bases.sh)
REPORTES_DB_URL=jdbc:postgresql://<endpoint-rds>:5432/reportes_db
REPORTES_DB_USER=reportes_user
REPORTES_DB_PASSWORD=
AUDITORIA_DB_URL=jdbc:postgresql://<endpoint-rds>:5432/auditoria_db
AUDITORIA_DB_USER=auditoria_user
AUDITORIA_DB_PASSWORD=

# Kafka (Spec 044). El clúster corre en la EC2 cleanfresh-kafka (EP5/despliegue/kafka/): usar su IP PRIVADA, con los 3 brokers.
# Apagado por defecto (KAFKA_ENABLED=false): sin clúster los servicios arrancan igual.
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=<ip-privada-ec2-kafka>:9092,<ip-privada-ec2-kafka>:9093,<ip-privada-ec2-kafka>:9094
